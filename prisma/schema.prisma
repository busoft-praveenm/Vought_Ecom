generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UserDb {
  id          Int       @id @default(autoincrement())
  userUid     String    @unique @map("user_uid")
  firebaseUid String    @unique @map("firebase_uid")
  email       String    @unique
  provider    String?
  status      UserStatus @default(ACTIVE)
  photoUrl    String?   @map("photo_url") @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  roleId      Int?      @map("role_id")
  role        RoleDb?   @relation(fields: [roleId], references: [id])

  profile     UserProfileDb?
  cart        CartDb?
  orders      OrderDb[]
  reviews     ProductReviewDb[]
  products    ProductsDb[]
  inventoryLocks InventoryLockDb[]

  @@map("tbl_user")
}

model RoleDb {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  users     UserDb[]

  @@map("tbl_role")
}

model UserProfileDb {
  id              Int       @id @default(autoincrement())
  firstName       String?   @map("first_name")
  lastName        String?   @map("last_name")
  mobileNumber    String?   @map("mobile_number")
  billingAddress  String?   @map("billing_address") @db.Text
  deliveryAddress String?   @map("delivery_address") @db.Text
  deliveryLat     Decimal?  @db.Decimal(10, 8) @map("delivery_lat")
  deliveryLng     Decimal?  @db.Decimal(11, 8) @map("delivery_lng")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  userId          Int       @unique @map("user_id")
  user            UserDb    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tbl_user_profile")
}

model CategoryDb {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?   @db.Text
  imageUrl    String?   @map("image_url") @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  products    ProductsDb[] @relation("product_categories")

  @@map("tbl_category")
}

model BrandDb {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?   @db.Text
  imageUrl    String?   @map("image_url") @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  products    ProductsDb[]

  @@map("tbl_brand")
}

model ProductsDb {
  id            Int       @id @default(autoincrement())
  productUid    String    @unique @map("product_uid")
  name          String
  sku           String    @unique
  description   String?   @db.Text
  price         Decimal   @db.Decimal(10, 2)
  stock         Int       @default(0)
  imageUrl      String?   @map("image_url") @db.Text
  status        ProductStatus @default(ACTIVE)
  currency      String    @default("INR")
  averageRating Decimal   @default(0) @db.Decimal(3, 2) @map("average_rating")
  isActive      Boolean   @default(true) @map("is_active")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  brandId       Int?      @map("brand_id")
  brand         BrandDb?  @relation(fields: [brandId], references: [id])

  createdById   Int?      @map("created_by_id")
  createdBy     UserDb?   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  categories    CategoryDb[] @relation("product_categories")
  cartItems     CartItemDb[]
  orderItems    OrderItemDb[]
  reviews       ProductReviewDb[]
  warehouseProducts WarehouseProductDb[]
  inventoryLocks InventoryLockDb[]

  @@fulltext([name, description])
  @@map("tbl_products")
}

model CartDb {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  userId    Int       @unique @map("user_id")
  user      UserDb    @relation(fields: [userId], references: [id], onDelete: Cascade)

  items     CartItemDb[]

  @@map("tbl_cart")
}

model CartItemDb {
  id        Int       @id @default(autoincrement())
  quantity  Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  cartId    Int       @map("cart_id")
  cart      CartDb    @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId Int       @map("product_id")
  product   ProductsDb @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("tbl_cart_items")
}

model OrderDb {
  id                Int       @id @default(autoincrement())
  subtotal          Decimal   @default(0) @db.Decimal(10, 2)
  tax               Decimal   @default(0) @db.Decimal(10, 2)
  total             Decimal   @default(0) @db.Decimal(10, 2)
  status            OrderStatus @default(PENDING)
  razorpayOrderId   String?   @map("razorpay_order_id")
  razorpayPaymentId String?   @map("razorpay_payment_id")
  razorpaySignature String?   @map("razorpay_signature")
  expectedDeliveryDate DateTime? @map("expected_delivery_date")
  distanceKm        Decimal?  @db.Decimal(10, 2) @map("distance_km")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  userId            Int       @map("user_id")
  user              UserDb    @relation(fields: [userId], references: [id])

  warehouseId       Int?      @map("warehouse_id")
  warehouse         WarehouseDb? @relation(fields: [warehouseId], references: [id])
  
  items             OrderItemDb[]
  inventoryLocks    InventoryLockDb[]

  @@map("tbl_order")
}

model OrderItemDb {
  id        Int       @id @default(autoincrement())
  quantity  Int       @default(1)
  price     Decimal   @db.Decimal(10, 2)

  orderId   Int       @map("order_id")
  order     OrderDb   @relation(fields: [orderId], references: [id])

  productId Int       @map("product_id")
  product   ProductsDb @relation(fields: [productId], references: [id])

  @@map("tbl_order_items")
}

model ProductReviewDb {
  id          Int       @id @default(autoincrement())
  rating      Int       @default(0)
  reviewText  String?   @map("review_text") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  userId      Int       @map("user_id")
  user        UserDb    @relation(fields: [userId], references: [id], onDelete: Cascade)

  productId   Int       @map("product_id")
  product     ProductsDb @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("tbl_product_review")
}

model WarehouseDb {
  id                  Int       @id @default(autoincrement())
  name                String
  address             String?   @db.Text
  lat                 Decimal   @db.Decimal(10, 8)
  lng                 Decimal   @db.Decimal(11, 8)
  processingTimeHours Int       @default(24) @map("processing_time_hours")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  warehouseProducts   WarehouseProductDb[]
  orders              OrderDb[]

  @@map("tbl_warehouse")
}

model WarehouseProductDb {
  id          Int       @id @default(autoincrement())
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  warehouseId Int       @map("warehouse_id")
  warehouse   WarehouseDb @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  productId   Int       @map("product_id")
  product     ProductsDb @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("tbl_warehouse_products")
}

enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  BLOCKED  @map("blocked")
}

enum ProductStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  ORDER_PLACED
  PACKAGING_DONE
  ASSIGNED_DELIVERY_AGENT
  OUT_FOR_DELIVERY
  DELIVERED
}

model InventoryLockDb {
  id        Int      @id @default(autoincrement())
  quantity  Int
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  productId Int      @map("product_id")
  product   ProductsDb @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId    Int      @map("user_id")
  user      UserDb   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId   Int      @map("order_id")
  order     OrderDb  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([productId, expiresAt])
  @@map("tbl_inventory_lock")
}
